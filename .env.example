# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=claimcontext
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── Paths ─────────────────────────────────────────────────────────────────────
DOCUMENTS_DIR=data/documents
PROMPTS_DIR=prompts

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=claimcontext

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama          # ollama | anthropic | openai
LLM_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=30

# ── Embedding ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
CHUNKER_VERSION=v1

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=10
RRF_K=60
RERANK_TOP_N=5
REFUSE_THRESHOLD=0.4

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Secrets (never set defaults here — load from real .env only) ──────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
