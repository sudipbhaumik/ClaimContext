# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=claimcontext
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── Paths ─────────────────────────────────────────────────────────────────────
DOCUMENTS_DIR=data/documents
PROMPTS_DIR=prompts

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=claimcontext

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama          # ollama | anthropic | openai
LLM_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=30

# ── Embedding ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
CHUNKER_VERSION=v1

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=10
RRF_K=60
RERANK_TOP_N=5
REFUSE_THRESHOLD=0.4

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── RAG eval judge  ─────────────────────────────────────────────────
# Local Ollama (mistral) works with no key but is slow (measured 14-38s/call on
# local hardware), making `make eval` painful to run regularly. Judging on a
# hosted API model is faster; different-family-from-answer-LLM (llama3.2) still
# holds as long as the judge provider/model differs from the answer LLM.
#   EVAL_RAGAS_LLM_PROVIDER=openai | anthropic | ollama
#   EVAL_RAGAS_LLM_MODEL=<model name for that provider>
# and set the matching API key below (OPENAI_API_KEY / ANTHROPIC_API_KEY).
# EVAL_RAGAS_LLM_PROVIDER=ollama
# EVAL_RAGAS_LLM_MODEL=mistral

# ── Secrets (never set defaults here — load from real .env only) ──────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
